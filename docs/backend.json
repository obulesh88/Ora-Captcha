
{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "walletAddress": {
          "type": "string",
          "description": "The user's unique ORA wallet address."
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the user was created."
        },
        "balance": {
            "type": "number",
            "description": "The user's ORA coin balance."
        }
      },
      "required": ["uid", "email", "walletAddress", "createdAt", "balance"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "A record of a user's transaction.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who made the transaction."
        },
        "type": {
          "type": "string",
          "description": "The type of transaction (e.g., 'Captcha Solved', 'Ad Watched', 'Withdrawal')."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the transaction."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of the transaction."
        },
        "status": {
          "type": "string",
          "description": "The status of the transaction (e.g., 'pending', 'successful', 'failed').",
          "enum": ["pending", "successful", "failed", "completed"]
        },
        "referenceId": {
            "type": "string",
            "description": "A unique reference ID for the transaction, especially for withdrawals."
        }
      },
      "required": ["userId", "type", "amount", "date", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "Stores user profile information."
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/transaction"
      },
      "description": "Stores all user transactions."
    }
  }
}
