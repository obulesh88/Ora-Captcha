/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a strict user-ownership model for user profiles and allows only authenticated users to create transaction records associated with their user ID.
 * @data-structure
 *   - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 *   - /transactions/{transactionId}: Stores all transactions, readable by anyone, but creatable only with correct userId
 * @key-security-decisions
 *   - Users can only access their own profile data. Listing all users is disallowed.
 *   - Transactions can be created by the user, but not updated or deleted.
 * @denormalization-for-authorization
 *   - The `transactions` collection requires the `userId` field to match the authenticated user's UID for write operations. This avoids the need for complex queries or joins.
 * @structural-segregation
 *   - No explicit segregation between public and private data is needed at this time.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profile information only to the user themselves.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile (e.g., auth.uid = "user123", userId = "user123").
     * @allow (create) Authenticated user can create their own profile (e.g., auth.uid = "user123", userId = "user123").
     * @allow (update) Authenticated user can update their own profile (e.g., auth.uid = "user123", userId = "user123").
     * @allow (delete) Authenticated user can delete their own profile (e.g., auth.uid = "user123", userId = "user123").
     * @deny (get) Authenticated user cannot read another user's profile (e.g., auth.uid = "user456", userId = "user123").
     * @deny (list) No one can list all users.
     * @deny (create) Unauthenticated user cannot create a profile.
     * @deny (update) Unauthenticated user cannot update a profile.
     * @deny (delete) Unauthenticated user cannot delete a profile.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource.data.uid == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to create transaction records for the authenticated user.
     * @path /transactions/{transactionId}
     * @allow (create) Authenticated user can create transaction record associated with their user ID (e.g., auth.uid = "user123", request.resource.data.userId = "user123").
     * @allow (get) Anyone can read transaction record.
     * @allow (list) Anyone can list transaction records.
     * @deny (create) Authenticated user cannot create transaction record for another user (e.g., auth.uid = "user123", request.resource.data.userId = "user456").
     * @deny (update) No one can update transaction record.
     * @deny (delete) No one can delete transaction record.
     * @principle Enforces that only the authenticated user can create transaction records associated with their user ID.
     */
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }
}