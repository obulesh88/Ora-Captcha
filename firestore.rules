/**
 * @fileoverview Firestore Security Rules for ORA.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and a public read, owner-write model for transactions.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the user themselves.
 * - /transactions/{transactionId}: Stores transaction data, publicly readable but writable only with correct user ID.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Transactions are publicly readable, but only the user associated with the transaction can create, update, or delete it.
 * - Listing all users is disallowed.
 *
 * Denormalization for Authorization:
 * - The 'transaction' documents require a 'userId' field for associating them with the user who initiated the transaction. This enables proper access control by the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile (auth.uid matches userId).
     * @deny (get) if the user is not the owner of the profile.
     * @deny (create) if the user's auth.uid does not match the userId.
     * @deny (update) if the user attempts to change the userId field.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to transaction records.
     * @path /transactions/{transactionId}
     * @allow (get, list) Publicly readable, any logged-in user may list all transactions
     * @allow (create) if the userId field matches the user's auth.uid.
     * @allow (update, delete) if the userId field matches the user's auth.uid and the document exists.
     * @deny (create) if the userId field does not match the user's auth.uid.
     * @principle Public read with owner-only writes.
     */
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingTransactionOwner(resource.data.userId);
      allow delete: if isExistingTransactionOwner(resource.data.userId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function isExistingTransactionOwner(transactionUserId) {
        return isSignedIn() && request.auth.uid == transactionUserId && resource != null;
    }
  }
}